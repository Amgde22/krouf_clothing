      <!-- logo as image -->
      <img class="logo-image" src={logo.src} alt="logo">
      
    </a>



    <a href={whatsappLink} target="_blank" class="cs-button-solid cs-nav-button whatsapp-bg">
      <!-- <Icon name={"mage--location-fill"} size={"35px"} /> -->
